// Project: Identity & Cloud Security Monitoring
// Use Case: Detect Possible Privilege Escalation
// Data Source: AzureActivity
// Purpose: Identify Azure RBAC role assignment activity
// Time Range: Last 48 hours

AzureActivity
| where TimeGenerated > ago(48h)
| where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE"
| extend RoleDetails = parse_json(tostring(Properties))
| extend RequestBody = parse_json(tostring(RoleDetails.requestbody))
| extend RoleDefinitionID = tostring(RequestBody.properties.roleDefinitionId)
| extend PrincipalID = tostring(RequestBody.properties.principalId)
| extend PrincipalType = tostring(RequestBody.properties.principalType)
| project TimeGenerated, Caller, CallerIpAddress, OperationNameValue, RoleDetails, RequestBody,
          ActivityStatusValue, ResourceId, RoleDefinitionID,
          PrincipalID, PrincipalType, Properties
| order by TimeGenerated desc

